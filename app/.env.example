# ─── AI auto-responder (OpenAI-compatible endpoint) ─────────────────────────
# Get an OpenRouter key at https://openrouter.ai
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ─── Auth (change this in production!) ───────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production

# ─── Backend port ─────────────────────────────────────────────────────────────
# In production behind nginx, keep this 8787. Nginx listens on 80/443.
PORTAL_PORT=8787
